# Copy this file to .env and fill in your values. .env is never committed/shared.

# ----- Notification method: choose ONE (or both) -----
# Set NOTIFY_METHOD to "twilio", "email_sms", or "both"
NOTIFY_METHOD=twilio

# ----- Option A: Twilio (real SMS, small per-text cost, requires signup) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100
TWILIO_TO_NUMBER=+15555550123

# ----- Option B: Free email-to-SMS gateway (no signup, uses your carrier) -----
# Send an email to your carrier's gateway address and it arrives as a text.
# Examples: 5551234567@vtext.com (Verizon), @txt.att.net (AT&T),
#           @tmomail.net (T-Mobile), @messaging.sprintpcs.com (Sprint)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_GATEWAY_TO=5551234567@vtext.com

# ----- General -----
# How often (seconds) to re-notify while an item STAYS in stock, to avoid spam.
RENOTIFY_COOLDOWN_SECONDS=1800
